---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="https://cdn.jsdelivr.net/gh/yurin-kami/KamiBlogImages/images/fav.png" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function () {
        var THEME_KEY = 'theme';
        var LIGHT_START_HOUR = 7;
        var DARK_START_HOUR = 19;
        var autoTimer = 0;

        function getStoredPreference() {
          try {
            var value = localStorage.getItem(THEME_KEY);
            return value === 'light' || value === 'dark' || value === 'auto' ? value : 'auto';
          } catch (_error) {
            return 'auto';
          }
        }

        function resolveAutoTheme(date) {
          var hour = (date || new Date()).getHours();
          return hour >= LIGHT_START_HOUR && hour < DARK_START_HOUR ? 'light' : 'dark';
        }

        function resolveTheme(preference) {
          return preference === 'auto' ? resolveAutoTheme() : preference;
        }

        function applyTheme(theme, preference) {
          var root = document.documentElement;
          root.classList.toggle('dark', theme === 'dark');
          root.dataset.theme = theme;
          root.dataset.themeMode = preference;
          root.style.colorScheme = theme;
        }

        function getNextAutoDelay() {
          var now = new Date();
          var next = new Date(now);
          var hour = now.getHours();

          if (hour < LIGHT_START_HOUR) {
            next.setHours(LIGHT_START_HOUR, 0, 0, 0);
          } else if (hour < DARK_START_HOUR) {
            next.setHours(DARK_START_HOUR, 0, 0, 0);
          } else {
            next.setDate(next.getDate() + 1);
            next.setHours(LIGHT_START_HOUR, 0, 0, 0);
          }

          return Math.max(1000, next.getTime() - now.getTime() + 100);
        }

        function scheduleAutoSync() {
          window.clearTimeout(autoTimer);
          if (getStoredPreference() !== 'auto') return;
          autoTimer = window.setTimeout(function () {
            syncTheme();
          }, getNextAutoDelay());
        }

        function syncTheme() {
          var preference = getStoredPreference();
          var theme = resolveTheme(preference);
          applyTheme(theme, preference);
          scheduleAutoSync();
          return { preference: preference, theme: theme };
        }

        function setPreference(preference) {
          var nextPreference = preference === 'light' || preference === 'dark' || preference === 'auto' ? preference : 'auto';
          try {
            localStorage.setItem(THEME_KEY, nextPreference);
          } catch (_error) {}
          return syncTheme();
        }

        window.__koharuTheme = {
          applyPreference: setPreference,
          getPreference: getStoredPreference,
          getResolvedTheme: function () {
            return resolveTheme(getStoredPreference());
          },
          sync: syncTheme,
        };

        syncTheme();

        window.addEventListener('storage', function (event) {
          if (event.key === THEME_KEY) syncTheme();
        });

        document.addEventListener('visibilitychange', function () {
          if (!document.hidden) syncTheme();
        });
      })();
    </script>
    <title>{title} - KAMISHOW!!!!!</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">首页</a>
        <a href="/posts">文章</a>
        <a href="/tags">标签</a>
        <a href="/search">搜索</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; 2025 KAMISHOW!!!!</p>
    </footer>
  </body>
</html>
