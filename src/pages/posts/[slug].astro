---
import Layout from '@/components/Layout.astro';
import { getCollection, render } from 'astro:content';
import { extractHeaders, getExcerpt, slugify } from '@/styles/utils';
import { getSortedPosts } from '@/lib/content';
import { defaultLocale } from '@/i18n';
import { localizedPath } from '@/i18n';

export async function getStaticPaths() {
  const posts = await getSortedPosts(defaultLocale);
  return posts.map((post) => {
    const filename = post.id.split('/').pop() || post.id;
    return {
      params: { slug: slugify(filename) },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
const headers = extractHeaders(post.body);
const excerpt = getExcerpt(post.body);
---

<Layout title={post.data.title}>
  <article class="post-article">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <span class="post-date">{new Date(post.data.date).toISOString().slice(0, 10)}</span>
        {post.data.tags && post.data.tags.length > 0 && (
          <span class="post-tags">
            {post.data.tags.map((tag) => (
              <a href={localizedPath(`/tags/${encodeURIComponent(tag.toLowerCase())}`, defaultLocale)} class="tag-link">{tag}</a>
            ))}
          </span>
        )}
      </div>
    </header>

    <div class="post-layout">
      <div class="article-content">
        <Content />
      </div>
      {headers.length > 0 && (
        <aside class="post-toc">
          <div class="toc">
            <h3>目录</h3>
            <ul>
              {headers.map((header) => (
                <li class={`toc-h${Math.min(header.level, 3)}`}>
                  <a href={`#${header.id}`}>{header.text}</a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </article>
</Layout>

<style>
  .post-article {
    max-width: 100%;
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 107, 157, 0.2);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .post-date {
    color: #666;
    font-size: 0.9rem;
  }

  .post-tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .tag-link {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    background-color: rgba(255, 230, 240, 0.8);
    color: #ff6b9d;
    border-radius: 15px;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .tag-link:hover {
    background-color: #ff6b9d;
    color: white;
    text-decoration: none;
  }

  .post-layout {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  .article-content {
    flex: 1;
    min-width: 0;
  }

  .post-toc {
    width: 250px;
    max-width: 250px;
    flex-shrink: 0;
    position: sticky;
    top: 2rem;
  }

  .toc ul {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }

  .toc ul li {
    margin-bottom: 0.3rem;
  }

  .toc-h2 {
    padding-left: 1rem;
  }

  .toc-h3 {
    padding-left: 2rem;
  }
</style>
